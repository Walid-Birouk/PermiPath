# Copy to `.env` and fill in. Never commit `.env`.

# Postgres connection. Local default matches infra/docker-compose.yml (the backend
# container overrides the host to `db`). Production: the Supabase connection string.
DATABASE_URL=postgresql://permipath:permipath@localhost:5432/permipath

# Disposable database used by the destructive migration tests (pytest -m db).
TEST_DATABASE_URL=postgresql://permipath:permipath@localhost:5432/permipath_test

# Mistral API (chat, embeddings, OCR). The project runs on a Mistral Pro subscription; an account
# without a billing plan is refused with HTTP 402 (billing_no_api_budget_configured).
MISTRAL_API_KEY=

# DeepSeek API (chat models only; eval tooling, never user questions).
DEEPSEEK_API_KEY=
# PISTE / Légifrance API (OAuth client credentials).
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Abuse and cost guardrails.
DAILY_QUESTION_LIMIT=20
MONTHLY_SPEND_CAP_EUR=5

# Allowed browser origins for the API (JSON list).
CORS_ORIGINS=["http://localhost:3000"]
