# Copy to `.env` and fill in. Never commit `.env`.

# Postgres connection. Local default matches infra/docker-compose.yml (the backend
# container overrides the host to `db`). Production: the Supabase connection string.
DATABASE_URL=postgresql://permipath:permipath@localhost:5432/permipath

# Disposable database used by the destructive migration tests (pytest -m db).
TEST_DATABASE_URL=postgresql://permipath:permipath@localhost:5432/permipath_test

# Mistral API (chat, embeddings, OCR). The project runs on a Mistral Pro subscription; an account
# without a billing plan is refused with HTTP 402 (billing_no_api_budget_configured).
MISTRAL_API_KEY=

# DeepSeek API (chat models only; eval tooling, never user questions).
DEEPSEEK_API_KEY=
# PISTE / Légifrance API (OAuth client credentials).
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Abuse and cost guardrails (D-020). Questions per visitor per day; visitors are counted by a
# salted daily hash of the client IP (never stored raw). /ask pauses for the month once the
# estimated spend reaches the cap.
DAILY_QUESTION_LIMIT=20
MONTHLY_SPEND_CAP_EUR=5
# Secret for the visitor hash. Empty: random per process (counts reset on restart). Set in
# production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
IP_HASH_SECRET=
# true behind the host's reverse proxy: read the client IP from X-Forwarded-For.
TRUST_FORWARDED_FOR=false
# Mistral list prices, USD per million tokens (docs.mistral.ai/inference/pricing, read
# 2026-11-27). Counted 1:1 as EUR by the spend cap. Update when Mistral changes its prices.
PRICE_CHAT_INPUT_PER_M=0.15
PRICE_CHAT_OUTPUT_PER_M=0.6
PRICE_EMBED_INPUT_PER_M=0.1

# Allowed browser origins for the API (JSON list).
CORS_ORIGINS=["http://localhost:3000"]
