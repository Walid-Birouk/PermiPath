# PermiPath environment variables. Copy to `.env` (git-ignored) and fill in. Never commit `.env`
# and never paste a secret into a chat, an issue or a commit.
#
# Each variable says where its value comes from and where it is set:
#   [local]   your `.env`, for local runs and evaluations
#   [backend] the backend host's environment variables (production)
#   [vercel]  Vercel > Project > Settings > Environment Variables (frontend)
#   [github]  GitHub > repository > Settings > Secrets and variables > Actions (nightly job)
# "Production:" gives the value to use on the backend host when it differs from the default.

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# [local] [backend] [github] Postgres with pgvector (migration 0001 enables the extension).
# Local: matches infra/docker-compose.yml (the backend container overrides the host to `db`).
# Production: Supabase > your project > "Connect" (top bar) > Connection string > "Session
# pooler" (IPv4-compatible; the direct connection is IPv6-only on the free plan), with the
# database password you chose at project creation (Project Settings > Database to reset it).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://permipath:permipath@localhost:5432/permipath

# [local] Same Supabase connection string, kept separately so local commands can load the
# production database on purpose (migrations, ingestion, embeddings, rules) without changing
# DATABASE_URL. Not read by the application.
SUPABASE_DATABASE_URL=

# [local] Disposable database for the destructive database tests (pytest -m db). Create it once:
# docker compose exec db createdb -U permipath permipath_test
TEST_DATABASE_URL=postgresql://permipath:permipath@localhost:5432/permipath_test

# ---------------------------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------------------------

# [local] [backend] [github] Mistral API key: console.mistral.ai > API Keys > Create new key.
# The project runs on a Mistral Pro subscription; an account without a billing plan is refused
# with HTTP 402 (billing_no_api_budget_configured). Use a separate key for production.
MISTRAL_API_KEY=

# [local] Optional, not read by the application yet (reserved for evaluation tooling; never
# for user questions). DeepSeek platform > API keys.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------------------------
# Légifrance (PISTE) - ingestion only, not needed by the API at runtime
# ---------------------------------------------------------------------------------------------

# [local] [github] OAuth client credentials of a PISTE application subscribed to the Légifrance
# API: piste.gouv.fr > "Applications" > your application > "Identifiants OAuth" (client id and
# secret). Sandbox and production are separate applications with separate credentials.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# [local] [github] sandbox | prod. Production (nightly job): prod, with the credentials of the
# PROD application subscribed to the Légifrance API.
PISTE_ENV=sandbox
# Optional overrides of the endpoints chosen by PISTE_ENV (leave empty).
PISTE_OAUTH_URL=
PISTE_API_URL=

# ---------------------------------------------------------------------------------------------
# Abuse and cost guardrails (D-020)
# ---------------------------------------------------------------------------------------------

# [backend] Questions per visitor per day. Visitors are counted by a salted daily hash of the
# client IP, never stored raw.
DAILY_QUESTION_LIMIT=20
# [backend] /ask pauses for the rest of the month once the estimated spend reaches this.
MONTHLY_SPEND_CAP_EUR=5
# [backend] Secret for the visitor hash; generate it yourself:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty: a random secret per process (counts reset on restart). Production: always set.
IP_HASH_SECRET=
# [backend] true when the API runs behind the host's reverse proxy (read the client IP from
# X-Forwarded-For). Production: true. Local: false.
TRUST_FORWARDED_FOR=false
# [backend] Mistral list prices, USD per million tokens (docs.mistral.ai/inference/pricing, read
# 2026-11-27). Counted 1:1 as EUR by the spend cap. Update when Mistral changes its prices.
PRICE_CHAT_INPUT_PER_M=0.15
PRICE_CHAT_OUTPUT_PER_M=0.6
PRICE_EMBED_INPUT_PER_M=0.1

# ---------------------------------------------------------------------------------------------
# API access from the browser
# ---------------------------------------------------------------------------------------------

# [backend] Allowed browser origins (JSON list). Production: the Vercel domain(s), e.g.
# ["https://permipath.vercel.app"] (Vercel > Project > Settings > Domains).
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------------------------
# Tracing (D-021)
# ---------------------------------------------------------------------------------------------

# [local] [backend] off (default) | full (local development and evals: question, prompt and
# answer are recorded) | metadata (structure, model, tokens, cost and safe metadata only; no
# text, CLAUDE.md rule 5). Production: metadata.
TRACING_MODE=off
# [local] [backend] cloud.langfuse.com > your project > Settings > API Keys > "Create new API
# keys" (public key pk-lf-..., secret key sk-lf-...). A separate project for production is
# recommended, so evaluation and development traces stay apart.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# [local] [backend] EU region. US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# [local] [backend] Production: production.
LANGFUSE_ENVIRONMENT=development

# ---------------------------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------------------------

# [vercel] URL of the backend API, read on the server side only (not exposed to the browser).
# Local: http://localhost:8000. Production: the backend host's public URL.
API_URL=http://localhost:8000
